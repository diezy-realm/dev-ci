# Per-repo settings for bin/ci-runner. Workflow labels in the repo must match RUNNER_PREFIX
# (runs-on: [self-hosted, linux, galleon-heavy|galleon-light]).
PROJECT=galleon-ci-runner
REPO_SLUG=diezy-realm/galleon-fleet
REPO_URL=https://github.com/diezy-realm/galleon-fleet
RUNNER_PREFIX=galleon
HEAVY_CPUS=3
HEAVY_MEM=14g
LIGHT_CPUS=1
LIGHT_MEM=4g
CI_TARGET_MAX_GB=60
