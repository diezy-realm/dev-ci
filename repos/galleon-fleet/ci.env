# Per-repo settings for bin/ci-poller (KEY=VALUE, no quoting).
REPO_SLUG=diezy-realm/galleon-fleet
# Local clone used once to seed the bare mirror (fast); later fetches go to GitHub.
SEED=/home/diezy/Apps/galleon-fleet
# PR target branches that get CI.
BASES=testing,main
# Docker volumes holding the warm caches (cargo registry, rustup, shared target dir, sccache).
# Prefix is `dev-ci` (not *-runner) so a cleanup matching "runner" never wipes the CI caches again.
VOL_PREFIX=dev-ci
CPUS=3
CPU_SHARES=256
MEM=14g
CI_TARGET_MAX_GB=60
# Auto-merge only PRs into these bases, whose head branch matches the regex (agy task branches).
# main is never auto-merged. Re-enabled to `testing` by Owner 2026-10-20: Repository Structure
# and Test are advisory (not blamed) and Required Gate is green; they still need a genuine fix
# on testing (submodule gitlink + offline heapless cache) but no longer block auto-merge.
AUTOMERGE_BASES=testing
AUTOMERGE_HEAD_REGEX=^feat/
