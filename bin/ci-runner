#!/usr/bin/env bash
# usage: ci-runner <repo> {up|down|ps|logs [svc]|token|restart}
#   up     build the image and (re)create the runners; registers on first start only
#   token  print a fresh registration token (needs gh with repo admin)
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
repo=${1:?usage: ci-runner <repo> <cmd>}; cmd=${2:?usage: ci-runner <repo> <cmd>}; shift 2
envf=$root/repos/$repo/runner.env
[ -f "$envf" ] || { echo "no $envf" >&2; exit 2; }
set -a; . "$envf"; set +a
compose=(docker compose -p "$PROJECT" --env-file "$envf" -f "$root/runner/docker-compose.yml")
case $cmd in
  token) exec gh api -X POST "repos/$REPO_SLUG/actions/runners/registration-token" --jq .token ;;
  up)    exec "${compose[@]}" up -d --build "$@" ;;
  *)     exec "${compose[@]}" "$cmd" "$@" ;;
esac
